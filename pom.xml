<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.4.3</version>
        <relativePath/>
    </parent>

    <groupId>com.xin</groupId>
    <artifactId>xin_test</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>xin_test</name>
    <description>Xin Test Spring Boot Project</description>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 覆盖 Spring Boot 2.4.3 默认的 1.18.16（不兼容 JDK 17 模块系统） -->
        <lombok.version>1.18.38</lombok.version>
        <mybatis-spring-boot.version>2.2.0</mybatis-spring-boot.version>
        <mysql.version>8.0.22</mysql.version>
        <!-- 嵌入式 TongWeb 版本占位：改为东方通发行包实际版本号（形如 7.0.E.3）
             详见 docs/tongweb-embedded-migration.md -->
        <tongweb.version>7.0.E.0</tongweb.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok（版本由 spring-boot-starter-parent 管理，IDE 需安装 Lombok 插件） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${mysql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Word 文档直接解析（纯 Java，无需外部程序）：
             poi 基础 + poi-ooxml（.docx/XWPF）+ poi-scratchpad（老式 .doc/HWPF），统一 5.0.0（JDK 8 兼容）。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>5.0.0</version>
        </dependency>

        <!-- PDF 文本层直接解析（纯 Java，无需外部程序）：
             pdfbox 2.0.x 支持 JDK 8；3.x 要求 JDK 11+，禁止升级。 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.22</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 嵌入式 TongWeb 7 容器（替换内嵌 Tomcat），默认不激活
             使用：mvn clean package -Ptongweb -DskipTests
             前置：先执行东方通发行包里的 installMavenJar.bat 安装 starter
             文档：docs/tongweb-embedded-migration.md -->
        <profile>
            <id>tongweb</id>
            <dependencies>
                <!-- 重新声明 web starter 并排除内嵌 Tomcat（profile 中可用 exclusion 覆盖） -->
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-tomcat</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <!-- TongWeb 7.0 嵌入式 Spring Boot 2.x 适配 starter -->
                <dependency>
                    <groupId>com.tongweb.springboot</groupId>
                    <artifactId>tongweb-spring-boot-starter-2.x</artifactId>
                    <version>${tongweb.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
